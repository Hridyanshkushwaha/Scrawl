# Port the server listens on (Render/Railway set this automatically).
PORT=3001

# Comma-separated list of browser origins allowed to call the API and open WebSockets.
# Only needed when the client is hosted on a different domain than the server
# (e.g. client on Vercel, server on Render). Leave empty when the server serves the client.
CLIENT_ORIGIN=

# Optional tuning (defaults shown).
# CHOOSE_SECONDS=15        seconds the drawer has to pick a word
# ROUND_END_SECONDS=6      seconds the round summary stays on screen
# RECONNECT_GRACE_MS=20000 how long a disconnected player keeps their seat
